{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch Server",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/cmd/server/",
      "envFile": "${workspaceFolder}/.env"
    },
    {
      "name": "Launch SQL Script",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/cmd/sql/",
      "envFile": "${workspaceFolder}/.env"
    },
    {
      "name": "Debug Test File",
      "type": "go",
      "request": "launch",
      "mode": "test",
      "program": "${fileDirname}"
    },
    {
      "name": "Debug Benchmark",
      "type": "go",
      "request": "launch",
      "mode": "test",
      "program": "${fileDirname}",
      "args": ["-bench", ".", "-benchmem", "-count", "1"]
    }
  ]
}
